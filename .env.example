# Copy to .env and fill in real values

# --- Data providers ---
TWELVE_DATA_API_KEY=your_key_here

# Failover providers (optional — system works without these)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (free: 25 req/day)
# Note: FX intraday requires premium plan on Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# Finnhub: https://finnhub.io (free: 60 req/min, FX via OANDA)
FINNHUB_API_KEY=

# FCS API: https://fcsapi.com (free tier: 300 candles/request). Serves
# fx/metals (forex/history) and indices (stock/history) — no crypto route
# used here. Falls through cleanly if unset.
FCS_API_KEY=

# Alpaca Market Data: https://alpaca.markets — crypto bars ONLY in this
# codebase (Alpaca has no FX/metals/index CFDs). First fallback after
# ccxt/Binance and the independent cross-check partner for
# core/data_confidence.py on BTCUSD/ETHUSD. Keys from the Alpaca
# dashboard; data host is data.alpaca.markets (override via
# ALPACA_DATA_URL) — the paper-api.alpaca.markets host is the TRADING
# API and is not used for bars. Falls through cleanly if unset.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# MarketAux: https://www.marketaux.com (free tier: 100 req/day). News +
# per-entity sentiment client (fundamentals/marketaux_client.py) built for
# H021 (research/results/registry.json) — pre-registered hypothesis on
# whether news sentiment improves the Sentiment engine. NOT wired into
# live trading until H021's controlled A/B test decides so.
MARKETAUX_API_KEY=

# TAAPI.io: https://taapi.io — indicator client (fundamentals/taapi_client.py),
# deliberately NOT consumed by any engine. Every engine already computes
# its own indicators locally via pandas, and the free tier's rate limit is
# too tight (single-digit seconds between calls) for real-time multi-symbol
# use even if a use case arose. Kept as available infrastructure only.
TAAPI_API_KEY=

# FRED (St. Louis Fed) — official macro series for the Macro engine:
# DXY proxy (DTWEXBGS), VIX (VIXCLS), yields (DGS10/DGS2). Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Optional — without it the keyless fredgraph.csv export is used.
FRED_API_KEY=

# Yahoo Finance: no key needed (used automatically as secondary failover)
# Provider failover order: Twelve Data → Yahoo Finance → Alpha Vantage → Finnhub

# MT5 (2026-07-27) — Wine-hosted bridge on this same VPS, NOT a remote
# service. MetaTrader5's official Python package is Windows-only, so a
# small bridge process (scripts/mt5_bridge/mt5_bridge_server.py) runs
# inside a Wine-hosted Windows Python + MT5 terminal and exposes a
# localhost-only HTTP API; core/data_providers.py._fetch_mt5 talks to it.
# Opt-in only — "mt5" is NOT in any DEFAULT_CHAINS entry; add it to a
# config.yaml data.provider_chains override once docs/MT5_BRIDGE_SETUP.md's
# verification steps pass. Leave both unset to disable MT5 entirely (the
# provider chain falls through cleanly, same as an unconfigured cTrader).
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# Dukascopy JForex (2026-08-08) — a locally-run, THIRD-PARTY, UNOFFICIAL
# bridge (github.com/ismailfer/dukascopy-api-websocket, "dukas-api") that
# wraps the official JForex SDK as a local REST+WebSocket service on this
# same VPS, NOT a remote service. core/data_providers.py._fetch_dukascopy_
# jforex talks to its GET /api/v1/history endpoint. Opt-in only —
# "dukascopy_jforex" is NOT in any DEFAULT_CHAINS entry; add it to a
# config.yaml data.provider_chains override once docs/
# DUKASCOPY_JFOREX_BRIDGE_SETUP.md's verification steps pass — review the
# bridge's source yourself before pointing even demo credentials at it.
# Leave unset to disable entirely (the provider chain falls through
# cleanly, same as an unconfigured MT5/cTrader).
DUKASCOPY_JFOREX_BRIDGE_URL=
# Self-reported only (the bridge documents no endpoint to query which
# server it's actually configured for) — must match the "demo"/"live"
# setting in the bridge's own application.properties. Same self-reported
# pattern as CTRADER_ENVIRONMENT/OANDA_ENVIRONMENT below.
DUKASCOPY_JFOREX_ENVIRONMENT=demo

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- API Server security (REQUIRED in production) ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_SERVER_KEY=your_random_secret_here

# --- News Intelligence (fundamentals layer) ---
# Economic calendar (pre-news blackout gate) is served by the Forex Factory
# public JSON feed — no API key required. A daily cron
# (scripts/cache_calendar.py) refreshes storage/calendar_cache.json, which the
# blackout gate reads first; the live feed and a minimal hardcoded US schedule
# are the fallbacks. No news-calendar key is needed here.

# Set to "development" to enable Swagger docs and skip auth requirement
ENV=production

# --- OANDA Paper/Live Trading ---
# Register free at https://www.oanda.com/
# Practice account = paper trading (no real money)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # "practice" or "live"

# --- cTrader Open API (OAuth 2.0) ---
# From your app at https://id.ctrader.com/my/settings/openapi/
# The client secret must NEVER leave the server: never sent to the
# frontend, never logged, never committed. See the "cTrader Connection"
# dashboard tab / integrations/ctrader/oauth.py.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Registered redirect URI for the OAuth web flow — must exactly match
# what's configured on the cTrader app (execution/routes/ctrader_auth.py).
CTRADER_REDIRECT_URI=https://your-domain.example/ctrader/callback
CTRADER_OAUTH_SCOPE=trading          # "trading" (can place orders) or "accounts" (read-only)
# Populated automatically by GET /ctrader/callback after a browser OAuth
# round trip, or manually via scripts/ctrader_refresh_access_token.py
# --write. Never hand-edit unless you know what you're doing — these
# rotate on every refresh.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Unix timestamp (seconds) the current CTRADER_ACCESS_TOKEN expires at —
# written by integrations/ctrader/token_manager.py and the OAuth
# callback. Used to trigger proactive refresh before expiry
# (scheduler.py's run_once()). Optional: if absent, only the reactive
# refresh-on-CH_ACCESS_TOKEN_INVALID path applies.
CTRADER_ACCESS_TOKEN_EXPIRY=
# ctidTraderAccountId (NOT the login number shown in the UI) — discover
# via GET /ctrader/callback's logged output, or run
# scripts/ctrader_list_accounts.py directly.
CTRADER_ACCOUNT_ID=
CTRADER_ENVIRONMENT=demo             # "demo" or "live"

# --- AI explanation layer (ai/ai_analyzer.py, opt-in via config.yaml ai.enabled) ---
# Only the key matching config.yaml's `ai.provider` is required.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Storage backend (required — Cloudflare D1, see cloudflare/README.md) ---
# decision_db.py / outcome_tracker.py / engine_tracker.py / experience_db.py /
# symbol_health.py / calibration.py all read and write through the Worker
# proxy in cloudflare/worker.js. Deploy that Worker first, then fill these
# in — there is no local SQLite fallback.
D1_WORKER_URL=
D1_PROXY_TOKEN=
